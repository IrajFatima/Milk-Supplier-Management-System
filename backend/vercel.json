{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/src/app.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/deliveries",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/temperature-logs",
      "schedule": "0 23 * * *"
    }
  ]
}